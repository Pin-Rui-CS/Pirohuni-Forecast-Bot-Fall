{
  "name": "apiagent-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A research agent over 24 public data APIs, with tiered provenance. Provider-neutral: no LLM SDK required.",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "ask": "node --env-file-if-exists=../.env examples/ask.ts",
    "tools": "node --env-file-if-exists=../.env examples/tools-only.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
