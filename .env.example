# =============================================================================
# Pirohuni Forecast Bot — single source of truth for configuration
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# ONE .env SERVES BOTH LANGUAGES. The Python bot loads this file via
# `dotenv.load_dotenv()` at config.py import, which puts every value into
# os.environ. apiagent-kit (TypeScript) is launched as a child process and
# inherits that environment, so it needs no .env of its own — do not create
# `apiagent-kit/.env`. To run its npm scripts by hand, they point at `../.env`.
#
# WHAT YOU ACTUALLY HAVE TO SET: the blocks marked REQUIRED, plus whichever
# optional provider keys you hold. EVERYTHING ELSE IN THIS FILE IS A CODE
# DEFAULT, listed so you know the knob exists -- not a blank to fill in.
# Leaving one unset is the supported case, not a gap.
# =============================================================================


# --- REQUIRED: Metaculus -----------------------------------------------------
METACULUS_TOKEN=


# --- REQUIRED: LLM routing ---------------------------------------------------
# Which endpoint every LLM call goes to. `LLM_PROVIDER` is the old name for the
# same setting and is still honoured, so existing CI variables keep working.
#   openrouter  (default) — everything through OpenRouter
#   openai                — everything through the direct OpenAI API
#
# Routing is a *profile*, not a single URL: a profile maps each internal
# role-carrying model name (anthropic/claude-opus-5 for the forecaster,
# compiler and tiebreaker roles; anthropic/claude-sonnet-5 for the research
# utilities) onto a concrete endpoint + model id + capability flags. Those
# flags are keyed on the MODEL FAMILY, not the provider, because e.g.
# `temperature` is rejected by GPT-5/6 reasoning models wherever they are
# served. See llm_provider.py.
LLM_ROUTING=openrouter
# LLM_PROVIDER=          # legacy alias for LLM_ROUTING; set one, not both

# Fill in the key for whichever routing mode you selected. The other may be
# left blank — only the active endpoint's key is required.
OPENROUTER_API_KEY=
OPENAI_API_KEY=


# --- REQUIRED: AskNews -------------------------------------------------------
# Use EITHER the OAuth pair OR the single API key — never both.
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=
# ASKNEWS_API_KEY=


# --- Reasoning effort (OpenAI routing only) ----------------------------------
# Defaults: `high` on the forecaster/compiler/tiebreaker model, `low` on the
# research utilities. Measured on question 44875: moving the Tier-1 calls from
# medium to high costs roughly +14% of a question. Input dominates that bill,
# so effort is a weak cost lever and a strong quality one on exactly those
# calls. Values: none|minimal|low|medium|high|xhigh|max
# OPENAI_REASONING_EFFORT=                    # overrides every model at once
# OPENAI_REASONING_EFFORT_GPT_5_6_SOL=high    # per-model: dots/dashes -> _
# OPENAI_REASONING_EFFORT_GPT_5_6_TERRA=low


# --- Prompt caching (OpenAI routing only) ------------------------------------
# GPT-5.6+ bills a cache WRITE at 1.25x the uncached input rate, and every
# prompt here is unique to one question, so the default `explicit` (no
# breakpoints = no caching, no write premium) avoids roughly an 8% input
# surcharge on writes that can never be read. Set to `implicit` only if you
# introduce calls sharing a long identical prefix.
# OPENAI_PROMPT_CACHE=explicit


# --- Forecaster ensemble -----------------------------------------------------
# Comma-separated pool, mapped onto runs in order and cycling when the run
# count exceeds the pool size. The pool should hold models of COMPARABLE
# quality: a materially weaker member drags the average instead of
# decorrelating it. Blank = the active routing profile's own default pool.
# FORECASTER_MODELS=
# FORECASTER_TIEBREAKER_MODEL=      # default: the profile's Tier-1 model

# When enabled (and runs >= 2) the LAST run reads the RAW deduplicated research
# instead of the compiled brief, on a different model. It is a swap, not an
# addition. Three incidents showed N same-model runs on one brief reproduce any
# brief-level skew at full weight; a raw-input run is the only member that can
# catch evidence the compile step dropped.
# HETEROGENEOUS_RUN_ENABLED=true
# HETEROGENEOUS_RUN_MODEL=


# --- Research providers: keys ------------------------------------------------
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=


# --- Research providers: toggles ---------------------------------------------
# The three web-search providers run as a priority fallback chain
# (SerpAPI -> Tavily -> Firecrawl): the bot uses the first that returns
# results and skips the rest, so enabling several conserves credits.
ENABLE_ASKNEWS_RESEARCH=true
ENABLE_RESOLUTION_SOURCE_RESEARCH=true
ENABLE_SERPAPI_RESEARCH=true
ENABLE_TAVILY_RESEARCH=true
ENABLE_FIRECRAWL_RESEARCH=true
ENABLE_PREDICTION_MARKET_RESEARCH=true

# Firecrawl-first scraping of general research URLs. Resolution-criteria
# scraping always tries Firecrawl when a key is present; this governs only the
# general research path.
# ENABLE_FIRECRAWL_GENERAL_SCRAPE=true

# Per-question Firecrawl credit cap, shared by the resolution and general
# paths. Resolution URLs get first claim: until the resolution scraper
# finishes, general research must leave the reserve untouched.
# FIRECRAWL_QUESTION_CREDIT_CAP=25
# FIRECRAWL_RESOLUTION_CREDIT_RESERVE=10

# Optional Firecrawl web time filter, e.g. qdr:w, qdr:m, sbd:1
FIRECRAWL_SEARCH_TBS=
# Tavily search depth: basic|advanced|fast|ultra-fast (basic = 1 credit/query)
TAVILY_SEARCH_DEPTH=basic
# AskNews cache: use_cache | use_cache_with_fallback | no_cache
ASKNEWS_CACHE_MODE=no_cache

# Per-question trace/ folder + evolution.md showing how the research changed
# step by step. Deterministic write-through only — no added LLM calls.
# ENABLE_RESEARCH_TRACE=true


# --- Metaculus API behaviour -------------------------------------------------
METACULUS_MAX_CONCURRENT_REQUESTS=1
METACULUS_REQUEST_INTERVAL=3.0
INITIAL_API_GET_RETRY_WAIT_SECONDS=3.0


# --- Budgets, concurrency, timeouts ------------------------------------------
# Per-question hard limit, in ESTIMATED TOKENS despite the historical name.
# 0 tracks usage without enforcing a limit.
OPENROUTER_COST_HARD_LIMIT_USD=0

# Input tokens held back so optional research (extra scrape cycles, provider
# fall-through, artifact retry) cannot starve the mandatory compile + forecast
# tail. Blank = computed from the run count.
# RESEARCH_RESERVE_INPUT_TOKENS=

# Global ceiling on in-flight LLM calls, across all questions.
# LLM_CONCURRENT_REQUESTS=5
# Questions forecast in parallel. 0 = unlimited (all at once).
# QUESTION_CONCURRENCY=0

# QUESTION_TIMEOUT_SECONDS=1200         # per-question wall clock
# ARTIFACT_RETRY_TIMEOUT_SECONDS=150    # focused artifact-retry budget

OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=2.0


# =============================================================================
# apiagent-kit — 24 public data APIs (TypeScript, runs as a child process)
# =============================================================================
# 22 of the 24 adapters need no credential at all. An API with no key is
# treated as ABSENT rather than broken: it is filtered out of the shortlist so
# the model is never offered something that cannot work.

# FRED — US + international economic time series (St. Louis Fed).
# The `fred` adapter switches itself off without this.
# Free, instant: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Metaculus — community forecasts. NOT a separate variable: the kit names
# this credential METACULUS_API_TOKEN, and apiagent-kit/cli.ts derives it
# from METACULUS_TOKEN above (same value, both sent as `Authorization:
# Token <t>`). Set METACULUS_API_TOKEN explicitly only if the adapter
# should use a DIFFERENT token from the bot's; an explicit value wins.

# GitHub — raises the rate limit from 60/hour to 5000/hour. The adapter works
# without it. A classic token with no scopes is enough for public data.
# GITHUB_TOKEN=

# SEC EDGAR — a contact email, appended to the User-Agent. The SEC throttles
# automated requests that do not identify themselves.
# NOTE: this is global — it lands in the UA on EVERY adapter's requests.
SEC_EDGAR_CONTACT=

# The outbound User-Agent is NOT configured here: apiagent-kit/cli.ts bakes
# in this project's name and URL. It identifies the project, not the
# machine, so there is nothing for a deployment to decide. Set
# APIAGENT_UA_PRODUCT / APIAGENT_UA_URL explicitly only to distinguish one
# host from another; an explicit value wins.


# =============================================================================
# Reserved — not read by any code yet
# =============================================================================
# NUS SoC LLM-as-a-Service gateway (free, open-weight models incl. Qwen 3.8).
# Wiring this up is the pending Tier-2 migration; the Endpoint abstraction in
# llm_provider.py already carries the rate-limit and startup-probe fields it
# needs. Key format: clsk_<prefix>_<secret>
# SOCLAAS_API_KEY=
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
