# Required
METACULUS_TOKEN=

# --- LLM provider ------------------------------------------------------------
# Which API the bot talks to. "openrouter" (default) is the historical
# behaviour; "openai" switches every LLM call to the direct OpenAI API.
# Only the selected provider's key is required.
#
# Switching to openai also changes, automatically (see llm_provider.py):
#   - models: anthropic/claude-opus-5 -> gpt-5.6-sol,
#             anthropic/claude-sonnet-5 -> gpt-5.6-terra
#   - forecaster pool: [gpt-5.6-sol, gpt-5.6-terra] (a capability ladder --
#     both Anthropic and OpenAI names would otherwise map to the same model)
#   - temperature is dropped (the GPT-5 reasoning models reject it)
#   - max_tokens becomes max_completion_tokens, grown to cover reasoning
#   - cost is computed from a local price table (OpenAI serves no per-call cost)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Reasoning effort, OpenAI only. Defaults: high on gpt-5.6-sol (the forecaster,
# compiler and tiebreaker roles), low on gpt-5.6-terra/luna (research
# utilities). Measured on question 44875, moving the sol calls from medium to
# high costs roughly +14% of a question; input dominates the bill, so effort is
# a weak cost lever and a strong quality one on exactly those calls.
# Values: none|minimal|low|medium|high|xhigh|max
# OPENAI_REASONING_EFFORT=            # overrides every model at once
# OPENAI_REASONING_EFFORT_GPT_5_6_SOL=high
# OPENAI_REASONING_EFFORT_GPT_5_6_TERRA=low

# Prompt caching, OpenAI only. GPT-5.6+ bills cache WRITES at 1.25x the
# uncached input rate and every prompt here is unique to one question, so the
# default "explicit" (no breakpoints = no caching, no write premium) avoids
# roughly an 8% input surcharge on writes that can never be read. Set to
# "implicit" only if you introduce calls sharing a long identical prefix.
# OPENAI_PROMPT_CACHE=explicit

# Required for AskNews research.
# Use either ASKNEWS_CLIENT_ID + ASKNEWS_SECRET or ASKNEWS_API_KEY, not both.
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=
# ASKNEWS_API_KEY=

# Optional Google SERP research provider
SERPAPI_API_KEY=

# Optional Firecrawl search research provider
FIRECRAWL_API_KEY=

# Optional Tavily search research provider
TAVILY_API_KEY=

# Research provider toggles. The three web-search providers run as a priority
# fallback chain (SerpAPI -> Firecrawl -> Tavily): the bot uses the first that
# returns results and skips the rest, so enabling several conserves credits.
ENABLE_ASKNEWS_RESEARCH=true
ENABLE_RESOLUTION_SOURCE_RESEARCH=true
ENABLE_SERPAPI_RESEARCH=true
ENABLE_FIRECRAWL_RESEARCH=true
ENABLE_TAVILY_RESEARCH=true
ENABLE_PREDICTION_MARKET_RESEARCH=true
# Optional Firecrawl web time filter, e.g. qdr:w, qdr:m, sbd:1
FIRECRAWL_SEARCH_TBS=
# Tavily search depth: basic|advanced|fast|ultra-fast (basic = 1 credit/query)
TAVILY_SEARCH_DEPTH=basic

# Optional Metaculus API behavior
METACULUS_MAX_CONCURRENT_REQUESTS=1
METACULUS_REQUEST_INTERVAL=3.0
INITIAL_API_GET_RETRY_WAIT_SECONDS=3.0

# Optional AskNews behavior
ASKNEWS_CACHE_MODE=no_cache

# Optional OpenRouter character/token usage tracking
# 0 means track usage but do not stop the run.
# Kept under the old env var name for compatibility; value is now estimated tokens.
OPENROUTER_COST_HARD_LIMIT_USD=0
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=2.0
